# AAATS — environment variable template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the secrets. .env is git-ignored.
# NEVER commit a populated .env file.

# ── Operator workstation SSH access to the Contabo box ──────────────────────
# Required by every script in tools/operator/. The box hostname/user defaults
# to the AAATS Tailscale node if these are unset.
AAATS_SSH_HOST=100.95.126.39
AAATS_SSH_USER=aaats
AAATS_SSH_PASSWORD=

# ── Box-side Grafana admin access ───────────────────────────────────────────
# Used by tools/operator/deploy_grafana_dashboard.py and the diagnostic
# scripts that hit /api/datasources via curl. Tailscale-only endpoint, but
# rotate alongside the SSH password if either ever leaks.
AAATS_GRAFANA_USER=admin
AAATS_GRAFANA_PASSWORD=
AAATS_GRAFANA_HOST=100.95.126.39:3000

# ── Box-side data paths (optional overrides) ────────────────────────────────
# Only set on the trading container; safe to leave blank locally.
AAATS_DATA=data
AAATS_RISK_STATE_FILE=/app/data/state/risk_engine_state.json

# ── India broker (Angel One SmartAPI) ───────────────────────────────────────
# Required when running NSE-side strategies. Test/CI uses synthetic values.
INDIA__ANGEL_API_KEY=
INDIA__ANGEL_CLIENT_ID=
INDIA__ANGEL_PASSWORD=
INDIA__ANGEL_TOTP_SECRET=

# ── US broker (Alpaca) ──────────────────────────────────────────────────────
US__ALPACA_API_KEY=
US__ALPACA_SECRET_KEY=

# ── Crypto (Binance via CCXT) ───────────────────────────────────────────────
# Leave blank for read-only public-data mode. Required only for live trading
# (which is gated by SYSTEM__TRADING_MODE=live, NOT enabled in paper builds).
BINANCE__API_KEY=
BINANCE__SECRET_KEY=

# ── Telegram alerting ───────────────────────────────────────────────────────
ALERTS__TELEGRAM_BOT_TOKEN=
ALERTS__TELEGRAM_CHAT_ID=

# ── System mode (DO NOT FLIP TO live WITHOUT FOLLOWING THE FLIP RUNBOOK) ────
# See docs/runbooks/2026-05-22_live_capital_go.md.
SYSTEM__TRADING_MODE=paper
