# D.2 heartbeat-watchdog sidecar
# Minimal image: python3 + docker CLI (for `docker restart`).
# Mounts the host docker socket; mounts ../data read-only.

FROM python:3.11-slim

WORKDIR /app

# Install docker CLI only (no daemon). On Debian 13 the CLI is shipped in a
# separate `docker-cli` package; the `docker.io` package only installs the
# daemon (dockerd, docker-proxy) and excludes the client. docker-cli depends
# only on libc6, so this stays lean (~30 MB) and gives us /usr/bin/docker.
RUN apt-get update && apt-get install -y --no-install-recommends \
    docker-cli \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir python-telegram-bot

# Copy only the modules we need (keeps the image small).
COPY health/ /app/health/
COPY observability/ /app/observability/
# D.4 daily digest is composed by the watchdog at 09:00 IST. The module reads
# the bind-mounted data dir so its sources are runtime state, not image-baked.
COPY monitoring/ /app/monitoring/

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

CMD ["python", "health/watchdog.py"]
