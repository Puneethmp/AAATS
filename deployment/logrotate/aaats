# AAATS Log Rotation Configuration
# Place in /etc/logrotate.d/aaats

/home/ubuntu/aaats/logs/*.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0644 ubuntu ubuntu
    sharedscripts
    postrotate
        # Signal containers to reopen log files if needed
        docker compose -f /home/ubuntu/aaats/deployment/docker-compose.yml kill -s USR1 aaats-paper-us aaats-paper-india aaats-paper-crypto 2>/dev/null || true
    endscript
}

/var/log/aaats-backup.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    create 0644 root root
}
