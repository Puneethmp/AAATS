# ══════════════════════════════════════════════════════════════
# AAATS Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── System ────────────────────────────────────────────────────
SYSTEM__TRADING_MODE=paper          # paper | live  — never set to live manually
SYSTEM__LOG_LEVEL=INFO
SYSTEM__LOG_RETENTION_DAYS=90
SYSTEM__HEALTH_CHECK_INTERVAL_SECONDS=300

# ── US Market (Alpaca) ────────────────────────────────────────
US__ALPACA_API_KEY=your_alpaca_api_key_here
US__ALPACA_SECRET_KEY=your_alpaca_secret_key_here
US__ALPACA_BASE_URL=https://paper-api.alpaca.markets
US__MAX_RISK_PER_TRADE=0.015        # 1.5% — do not increase
US__MAX_PORTFOLIO_EXPOSURE=0.06     # 6% max open at once
US__DRAWDOWN_HALT=-0.15             # -15% triggers US kill switch

# ── India Market (Angel One SmartAPI — free with demat account) ──
# Setup:
#   1. Create Angel One demat account at angelbroking.com
#   2. Get API credentials from: smartapi.angelbroking.com → My Account → Settings → API
#      - API Key: copy and paste into INDIA__ANGEL_API_KEY
#      - Client ID: your Angel One login ID (e.g., REDACTED_ANGEL_CLIENT_ID)
#   3. Your Angel One PIN (4-digit login PIN): into INDIA__ANGEL_PIN
#   4. Your TOTP secret (2FA backup code): into INDIA__ANGEL_TOTP_SECRET
#   5. Keep these values secure — never commit .env to version control
#
# IMPORTANT: Token renewal happens automatically every day via TOTP.
#            If renewal fails, India trading halts automatically + alerts sent.
INDIA__ANGEL_API_KEY=your_angel_api_key_here
INDIA__ANGEL_CLIENT_ID=your_angel_client_id_here    # e.g., REDACTED_ANGEL_CLIENT_ID
INDIA__ANGEL_PIN=your_angel_pin_here                # 4-digit PIN (e.g., 9066)
INDIA__ANGEL_TOTP_SECRET=your_totp_secret_here      # Backup TOTP secret (e.g., JZCRAQDC7SYURTQE5VR5GALAF4)
INDIA__MAX_RISK_PER_TRADE=0.015      # 1.5% equity — do not increase
INDIA__FO_MAX_RISK_PER_TRADE=0.010   # 1.0% F&O — stricter, do not increase
INDIA__DRAWDOWN_HALT=-0.15           # -15% halts India trading (kill switch)

# ── Cross-Market Risk ─────────────────────────────────────────
RISK__TOTAL_DRAWDOWN_HALT=-0.20     # -20% total portfolio = full system halt
RISK__MAX_TOTAL_DEPLOYMENT=0.40     # 40% max deployed across all markets

# ── Alerts (Telegram) ─────────────────────────────────────────
ALERTS__TELEGRAM_BOT_TOKEN=your_bot_token_here
ALERTS__TELEGRAM_CHAT_ID=your_chat_id_here

# ── Phase 8 Only (Crypto) — uncomment when ready ─────────────
# COINGECKO_API_KEY=your_key_here
# CCXT_EXCHANGE=binance
# CCXT_API_KEY=your_key_here
# CCXT_SECRET_KEY=your_key_here
