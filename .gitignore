# ── Secrets — NEVER commit ────────────────────────────────────
.env
*.env
.env.live
.env.live.*
secrets/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
MANIFEST
*.egg

# ── Virtual Environment ───────────────────────────────────────
venv/
env/
ENV/
.venv/

# ── Trading Data — never commit raw market data ───────────────
data/*
logs/
# Allow dashboard state files for Streamlit Cloud
!data/paper_trades.db
!data/positions.db
!data/equity_curve.db
!data/slippage.db
!data/status.db
# Audit log of USE_UNIFIED_LEDGER flag flips (see scripts/deploy_ledger_flag.py)
!data/ledger_flag_history.json
!data/halt_state.json
!data/phase1_checkpoint.json
!data/phase1_metrics.json

# ── ML model weights ──────────────────────────────────────────
models/
*.pkl
*.joblib
*.pt
*.pth

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Testing / Coverage ────────────────────────────────────────
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# ── Pre-commit ────────────────────────────────────────────────
.pre-commit-cache/

# ── Operator-local — per-machine, never committed ─────────────
# See docs/conventions/operator_local_files.md
tools/local/
# Per-machine Claude Code permissions (analogous to .vscode/settings.json)
.claude/settings.json
# Transient diagnostic outputs
data/diagnostics/
diagnostics/reports/
