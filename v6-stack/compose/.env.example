# AAATS v6 — Compose environment template
# Copy to /srv/aaats/compose/.env and fill in.
# This file is safe to commit; it must NEVER contain secrets.
# Secrets live in /srv/aaats/secrets/* (mode 0600, owned by aaats).

# ----- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=aaats
POSTGRES_DB=aaats
# Password: written to /srv/aaats/secrets/postgres_password (NOT here)

# ----- Redis -----------------------------------------------------------------
# Password: written to /srv/aaats/secrets/redis_password (NOT here)

# ----- Cloudflare Tunnel -----------------------------------------------------
# Token: written to /srv/aaats/secrets/cloudflared_token (NOT here)
# Source: https://one.dash.cloudflare.com → Networks → Tunnels → (your tunnel)
#         → Connectors → Install connector → Docker → copy token

# ----- Grafana Cloud (free tier) ---------------------------------------------
# Source: https://grafana.com/orgs/<your-org>/access-policies (or Stack details)
# Prometheus and Loki may have different USER IDs and URLs but share one API key.
# The API key is written to /srv/aaats/secrets/grafana_api_key (NOT here).
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-XX-X.grafana.net/api/prom/push
GRAFANA_PROM_USER=000000
GRAFANA_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=000000
