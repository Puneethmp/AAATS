[Unit]
Description=AAATS v6 hourly backup (Postgres + Redis → Cloudflare R2)
Documentation=file:///srv/aaats/scripts/backup.sh
After=docker.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=aaats
Group=aaats
ExecStart=/srv/aaats/scripts/backup.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
# Soft hardening (root not required; aaats user already in docker group)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
